NODE_ENV=development
# 0.0.0.0 lets the phone reach the API over Wi-Fi too; over USB use `adb reverse tcp:4000 tcp:4000`.
HOST=0.0.0.0
PORT=4000
API_PREFIX=/api/v1
# Comma-separated list, or * to allow all
CORS_ORIGINS=*
LOG_LEVEL=debug

# MongoDB
# Local:  mongodb://127.0.0.1:27017
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# URL-encode special characters in the password (@ -> %40, : -> %3A, / -> %2F, # -> %23).
MONGODB_URI=mongodb://127.0.0.1:27017
# The database is chosen here, not in the URI. Use a different name per environment.
MONGODB_DB_NAME=nexity_dev
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# Redis (Optional in local dev, recommended in multi-instance production for Socket.IO & distributed rate limiting)
# Local: redis://127.0.0.1:6379
# Cloud (Upstash / Redis Cloud): rediss://default:<password>@<host>:<port>
# If left empty, fallback to in-memory store and single-server in-process Socket.IO.
REDIS_URL=

# Auth. Required in production (min 32 chars). Development falls back to a built-in secret.
# Generate one: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7

# Email (OTP codes for sign-up and password reset). Required in production.
# Leave SMTP_HOST empty in development: codes are logged and returned as `dev_code` in API responses.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Nexity <no-reply@nexity.app>
# Hosts that block SMTP (Render free tier): send through Brevo's HTTPS API instead.
# When set, SMTP_* is ignored. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=

# Keep-Alive Self-Ping (to prevent Render free tier instance from sleeping)
# Render automatically injects RENDER_EXTERNAL_URL in production web services.
# Or set APP_URL=https://your-service.onrender.com manually.
# GIFs in chat (proxied so the key never ships in the app). Free key: https://developers.giphy.com/dashboard/
# Leave empty to disable the GIF picker (the API returns 503 GIFS_NOT_CONFIGURED).
GIPHY_API_KEY=
GIPHY_RATING=pg-13

# How long a user stays "Active now" after their last socket disconnects (covers app switches / flaky networks).
PRESENCE_OFFLINE_GRACE_MS=15000

KEEP_ALIVE_ENABLED=true
KEEP_ALIVE_INTERVAL_MS=600000
# APP_URL=https://nexity-backend.onrender.com

# Media storage (AWS S3). Required in production; without it media endpoints return 503.
# Setup steps: documentation/architecture/MEDIA_STORAGE.md
AWS_REGION=ap-south-1
# IAM user keys with access to the bucket only. Leave both empty to use an IAM role / ~/.aws profile.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
# CloudFront domain (recommended) or bucket URL that serves files, no trailing slash.
# Empty = https://<S3_BUCKET>.s3.<AWS_REGION>.amazonaws.com
MEDIA_PUBLIC_BASE_URL= https://de59yh8s0cm1l.cloudfront.net
# S3-compatible endpoint for local testing (MinIO / LocalStack). Leave empty for AWS.
S3_ENDPOINT=
# How long a presigned upload stays valid (60-3600 seconds).
MEDIA_UPLOAD_URL_TTL_SECONDS=900

# Secret Messages. 32 random bytes (base64) that encrypt message bodies at rest. Required in production.
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRET_MESSAGES_KEY=
# Lets testers switch plan from the Plans screen without paying (POST /subscriptions/dev/activate).
# Defaults to on outside production; must be off (or unset) in production.
DEV_PLAN_SWITCH=true

# Payments (Razorpay). Set both keys or neither. Test keys: https://dashboard.razorpay.com/app/keys (Test mode)
# Without keys: development uses a built-in payment simulator; production turns payments off.
RAZORPAY_KEY_ID= rzp_test_Tm9OV8ep2eocvP
RAZORPAY_KEY_SECRET= CCYSWMi36ABdMqNeMZfI6dug
# Dashboard → Webhooks → URL https://<api-host>/api/v1/webhooks/razorpay with the payment.*, order.paid,
# subscription.*, refund.processed, payment.dispute.created and qr_code.credited events.
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_LOGO_URL=
# Platforms that may use Razorpay. Android and iOS share the same checkout.
PAYMENTS_ENABLED_PLATFORMS=android,ios,web

# Nearby ("This person was near you today/yesterday"). Location is sampled only while the app is open.
NEARBY_ENABLED=true
NEARBY_RADIUS_METERS=50
NEARBY_MIN_ENCOUNTER_DURATION_SECONDS=120
NEARBY_LOCATION_ACCURACY_LIMIT_METERS=40
NEARBY_LOCATION_SAMPLE_SECONDS=120
NEARBY_ENCOUNTER_COOLDOWN_MINUTES=30
NEARBY_NOTIFICATION_COOLDOWN_MINUTES=360
NEARBY_MAX_PUSHES_PER_DAY=3
NEARBY_ENCOUNTER_RETENTION_DAYS=2

# Hosts that block SMTP (Render free tier): send through Brevo's HTTPS API instead.
# When set, SMTP_* is ignored. MAIL_FROM must be a sender verified in Brevo.
BREVO_API_KEY=